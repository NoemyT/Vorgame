generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         Int         @id @default(autoincrement())
  nome       String
  email      String      @unique @db.VarChar(254)
  username   String      @unique
  senhaHash  String      @db.VarChar(255)
  criadoEm   DateTime    @default(now())
  avaliacoes Avaliacao[]
}

model Jogo {
  id              Int         @id @default(autoincrement())
  titulo          String
  capa            String      @db.VarChar(2048)
  descricao       String      @db.Text
  genero          String
  plataformas     Json
  mediaAvaliacao  Decimal?    @db.Decimal(3, 1)
  totalAvaliacoes Int         @default(0)
  chaveSeed       String?     @unique
  avaliacoes      Avaliacao[]
}

model Avaliacao {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  jogoId       Int
  nota         Int
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  jogo         Jogo     @relation(fields: [jogoId], references: [id])

  @@unique([usuarioId, jogoId])
  @@index([jogoId])
}
