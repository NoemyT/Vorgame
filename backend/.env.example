# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env nunca deve ser enviado ao Git.

# String de conexão do TiDB Cloud (aba Connect > Prisma), com o banco "vorgame"
DATABASE_URL="mysql://USUARIO:SENHA@HOST:4000/vorgame?sslaccept=strict"

# Porta da API. No Render, ela é definida automaticamente.
PORT=3000

# Origens que podem chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Segredo aleatório de alta entropia, exclusivo do backend.
JWT_SECRET=
